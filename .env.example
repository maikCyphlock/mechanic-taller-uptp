# Database
DATABASE_URL="postgresql://username:password@localhost:5432/taller_db"

# Data Provider Mode: 'local' or 'odoo'
# - local: Uses PostgreSQL/SQLite database only, no Odoo required (default)
# - odoo: Connects to Odoo backend for data source
DATA_PROVIDER="local"
NEXT_PUBLIC_DATA_PROVIDER="local"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# ============================================================================
# Odoo Integration (only required when DATA_PROVIDER="odoo")
# ============================================================================
ODOO_URL="http://localhost:8069"
ODOO_DB="odoo_db"
ODOO_USERNAME="admin"
ODOO_PASSWORD="admin"